{
  "manifest_version": 3,
  "name": "AutoFolio",
  "version": "0.13.0",
  "description": "저장한 이력으로 지원서 입력칸을 채우고 결과를 확인합니다.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "content_scripts": [{
    "matches": ["https://postcode.map.kakao.com/*", "https://postcode.map.daum.net/*"],
    "js": ["postcode-frame.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "action": { "default_title": "AutoFolio", "default_popup": "popup.html" },
  "options_page": "options.html"
}
